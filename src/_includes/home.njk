{% from "quote.njk" import render_quote %}
{% set t = copy[lang] %}
<div class="hero">
  <img src="/images/photo.jpg" alt="{{ t.portrait_alt }}" width="665" height="665">
  <div>
    <h1>{{ t.name }}</h1>
    <p class="role">{{ t.role }}</p>
    <div class="intro">
      {% if t.intro is string %}
      <p>{{ t.intro }}</p>
      {% else %}
      {% for para in t.intro %}
      <p>{{ para }}</p>
      {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% if t.testimonials %}
<section class="testimonials" aria-labelledby="testimonials-heading">
  <h2 id="testimonials-heading" class="visually-hidden">{{ t.testimonials_heading }}</h2>
  {% for q in t.testimonials %}
  {{ render_quote(q, t, lang) }}
  {% endfor %}
</section>
{% endif %}

<section class="section" aria-labelledby="work-heading">
  <h2 id="work-heading">{{ t.work_heading }}</h2>

  {% for p in t.projects %}
  <article class="project">
    <div class="project-images">
      {% for img in p.images %}
      <img src="/images/{{ img.file }}" alt="{{ img.alt }}" width="480" height="320">
      {% endfor %}
    </div>
    <div class="project-text">
      <h3>{{ p.title }}</h3>
      <dl class="glance">
        <div>
          <dt>{{ t.glance_labels.role }}</dt>
          <dd>{{ p.glance.role }}</dd>
        </div>
        <div>
          <dt>{{ t.glance_labels.scope }}</dt>
          <dd>{{ p.glance.scope }}</dd>
        </div>
        <div>
          <dt>{{ t.glance_labels.outcome }}</dt>
          <dd>{{ p.glance.outcome }}</dd>
        </div>
      </dl>
      {% for s in p.sections %}
      <h4>{{ s.heading }}</h4>
      {% for para in s.paragraphs %}
      <p>{{ para }}</p>
      {% endfor %}
      {% endfor %}
      <h4>{{ t.outcome_label }}</h4>
      {% for para in p.outcome %}
      <p>{{ para }}</p>
      {% endfor %}
    </div>
    {% if p.quote %}
    {{ render_quote(p.quote, t, lang) }}
    {% endif %}
  </article>
  {% endfor %}
</section>

<section class="section" aria-labelledby="contact-heading">
  <h2 id="contact-heading">{{ t.contact_heading }}</h2>
  <p>{{ t.contact_text }}</p>
  <ul class="contact-list">
    {% for link in t.contact_links %}
    <li><a href="{{ link.url }}">{{ link.label }}</a></li>
    {% endfor %}
  </ul>
</section>
