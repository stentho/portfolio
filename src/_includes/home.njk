{% from "quote.njk" import render_quote %}
{% from "glance.njk" import render_glance %}
{% from "block.njk" import render_block %}
{% from "sections.njk" import render_sections %}
{% set t = copy[lang] %}
<div class="hero">
  <img src="/images/photo.jpg" alt="{{ t.portrait_alt }}" width="665" height="665">
  <div>
    <h1>{{ t.name }}</h1>
    <p class="role">{{ t.role }}</p>
    <div class="intro">
      <p class="intro-lead">{{ t.intro_lead }}</p>
      {% if t.intro is string %}
      <p>{{ t.intro | safe }}</p>
      {% else %}
      {% for para in t.intro %}
      <p>{{ para | safe }}</p>
      {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% if t.testimonials %}
<section class="testimonials" aria-labelledby="testimonials-heading">
  <h2 id="testimonials-heading" class="visually-hidden">{{ t.testimonials_heading }}</h2>
  {% for q in t.testimonials %}
  {{ render_quote(q, t, lang) }}
  {% endfor %}
</section>
{% endif %}

{% if t.about %}
<section class="section about" aria-labelledby="about-heading">
  <h2 id="about-heading">{{ t.about.heading }}</h2>
  {% for s in t.about.sections %}
  <details class="about-item">
    <summary><span>{{ s.heading | safe }}</span></summary>
    {% for para in s.paragraphs %}
    <p>{{ para | safe }}</p>
    {% endfor %}
  </details>
  {% endfor %}
</section>
{% endif %}

<section class="section" aria-labelledby="work-heading">
  <h2 id="work-heading">{{ t.work_heading }}</h2>
  {% for p in t.projects %}
  <article class="project">
    <div class="project-text">
      {% if p.cover %}
      <img class="cover" src="/images/{{ p.cover.file }}" alt="{{ p.cover.alt }}" width="480" height="320">
      {% endif %}
      <h3>{{ p.title }}</h3>
      {{ render_glance(p.glance) }}
      {{ render_block(p.intro) }}
      {% if p.subcases %}
      <div class="subcases">
        {% for sc in p.subcases %}
        <article class="subcase">
          {% if sc.cover %}
          <img class="cover" src="/images/{{ sc.cover.file }}" alt="{{ sc.cover.alt }}" width="480" height="320">
          {% endif %}
          <h4>{{ sc.title }}</h4>
          <p class="teaser">{{ sc.teaser }}</p>
          {{ render_glance(sc.glance) }}
          <details class="more">
            <summary>{{ t.subcase_more }}<span class="visually-hidden">: {{ sc.title }}</span></summary>
            {% for para in sc.paragraphs %}{{ para | md | safe }}{% endfor %}
            {{ render_sections(sc.sections, 5, t, lang) }}
          </details>
        </article>
        {% endfor %}
      </div>
      {% endif %}
      {{ render_block(p.synthesis) }}
      {% if p.sections | length %}
      <details class="more">
        <summary>{{ t.read_more }}</summary>
        {% for s in p.sections %}
        <div class="case-section">
          {% if s.image %}
          <img class="case-image" src="/images/{{ s.image.file }}" alt="{{ s.image.alt }}" width="480" height="320">
          {% endif %}
          <h4>{{ s.heading }}</h4>
          {% for para in s.paragraphs %}
          <p>{{ para | safe }}</p>
          {% endfor %}
        </div>
        {% endfor %}
      </details>
      {% endif %}
    </div>
    {% if p.quote %}
    {{ render_quote(p.quote, t, lang) }}
    {% endif %}
  </article>
  {% endfor %}
</section>

<section class="section" aria-labelledby="contact-heading">
  <h2 id="contact-heading">{{ t.contact_heading }}</h2>
  <p>{{ t.contact_text }}</p>
  <ul class="contact-list">
    {% for link in t.contact_links %}
    <li><a href="{{ link.url }}">{{ link.label }}</a></li>
    {% endfor %}
  </ul>
</section>
